---
const { page } = Astro.props;
---

<nav class="mt-8 flex justify-center" aria-label="Blog pagination">
  <div class="join">
    {page.url.prev ? (
      <a href={page.url.prev} class="join-item btn btn-sm" aria-label="Previous page">«</a>
    ) : (
      <button class="join-item btn btn-sm" type="button" disabled aria-label="No previous page">«</button>
    )}
    <span class="join-item btn btn-sm pointer-events-none" aria-current="page">
      {page.currentPage} / {page.lastPage}
    </span>
    {page.url.next ? (
      <a href={page.url.next} class="join-item btn btn-sm" aria-label="Next page">»</a>
    ) : (
      <button class="join-item btn btn-sm" type="button" disabled aria-label="No next page">»</button>
    )}
  </div>
</nav>
