---
import type { GetStaticPaths, Page } from "astro";
import Pagination from "@/components/ui/Pagination.astro";
import Layout from "@/layouts/Layout.astro";
import { blogDateISO, compareBlogPosts, formatBlogDate } from "@/lib/blog";
import { trimExcerpt } from "@/lib/utils";
import { template } from "@/settings";
import { getCollection } from "astro:content";

type PostSummary = {
  title: string;
  date: Date;
  tags: string[];
  excerpt: string;
  slug: string;
};

export const getStaticPaths = (async ({ paginate }) => {
  const posts: PostSummary[] = (await getCollection("blog"))
    .sort(compareBlogPosts)
    .map((post) => ({
      title: post.data.title,
      date: post.data.date,
      tags: post.data.tags,
      excerpt: trimExcerpt(post.data.excerpt),
      slug: `${template.base}/blog/${post.id}`,
    }));

  return paginate(posts, { pageSize: template.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<PostSummary> };
---

<Layout
  title="Blog | Yicheng Xu"
  description="Notes on control theory, optimization, dynamics, and research software."
>
  <div>
    <h1 class="mb-3 text-3xl font-bold">Blog</h1>
    <p class="mb-8 max-w-2xl text-base-content/70">
      Technical notes on systems, optimization, and tools for control researchers.
    </p>
    <div class="grid gap-6">
      {page.data.map((post) => (
        <article class="card bg-base-200 transition-shadow hover:shadow-md">
          <div class="card-body">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <h2 class="card-title text-xl">
                <a href={post.slug} class="hover:text-accent">{post.title}</a>
              </h2>
              {post.tags[0] && (
                <span class="badge badge-accent badge-outline">{post.tags[0]}</span>
              )}
            </div>
            <time datetime={blogDateISO(post.date)} class="text-sm text-base-content/70">
              {formatBlogDate(post.date)}
            </time>
            <p class="mt-3 text-base-content/80">{post.excerpt}</p>
            <div class="card-actions justify-end">
              <a href={post.slug} class="btn btn-sm btn-secondary">
                Read article
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <Pagination page={page} />
  </div>
</Layout>
