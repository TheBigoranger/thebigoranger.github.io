---
import type { GetStaticPaths, Page } from "astro";
import Pagination from "@/components/ui/Pagination.astro";
import Layout from "@/layouts/Layout.astro";
import { blogDateISO, compareBlogPosts, formatBlogDate } from "@/lib/blog";
import { template } from "@/settings";
import { getCollection } from "astro:content";

type PostSummary = {
  title: string;
  date: Date;
  tags: string[];
  excerpt: string;
  slug: string;
};

export const getStaticPaths = (async ({ paginate }) => {
  const posts: PostSummary[] = (await getCollection("blog"))
    .sort(compareBlogPosts)
    .map((post) => ({
      title: post.data.title,
      date: post.data.date,
      tags: post.data.tags,
      excerpt: post.data.excerpt,
      slug: `${template.base}/blog/${post.id}`,
    }));

  return paginate(posts, { pageSize: template.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<PostSummary> };
---

<Layout
  title="Blog | Yicheng Xu"
  description="Notes on control theory, optimization, dynamics, and research software."
  variant="blog"
>
  <div class="blog-index">
    <header class="blog-index-intro">
      <h1>Blog</h1>
      <p>Technical notes on systems, optimization, and tools for control researchers.</p>
    </header>
    <div class="blog-stream">
      {page.data.map((post) => (
        <article class="blog-stream-item">
          <div class="blog-stream-content">
            <time datetime={blogDateISO(post.date)}>{formatBlogDate(post.date)}</time>
            <h2><a href={post.slug}>{post.title}</a></h2>
            <p>{post.excerpt}</p>
            <div class="blog-tags" aria-label="Tags">
              {post.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
          <a href={post.slug} class="blog-read-link" aria-label={`Read ${post.title}`}>
            Read article <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
    <div class="blog-pagination"><Pagination page={page} /></div>
  </div>
</Layout>
