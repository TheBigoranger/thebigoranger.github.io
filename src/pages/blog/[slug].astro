---
import type { CollectionEntry } from "astro:content";
import BlogToc from "@/components/ui/BlogToc.astro";
import Layout from "@/layouts/Layout.astro";
import { blogDateISO, formatBlogDate } from "@/lib/blog";
import { numberHeadings } from "@/lib/heading-numbers.mjs";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { title, date, tags, excerpt } = post.data;
const { Content, headings } = await render(post);
const toc = numberHeadings(headings);
---

<Layout title={`${title} | Yicheng Xu`} description={excerpt} type="article" fullWidth variant="blog">
  <div class="blog-article-layout">
    <article class="blog-article" data-blog-article>
      <header class="blog-article-header">
        <h1>{title}</h1>
        <div class="blog-article-meta">
          <time datetime={blogDateISO(date)}>{formatBlogDate(date)}</time>
          {tags.length > 0 && (
            <div class="blog-tags" aria-label="Tags">
              {tags.map((tag: string) => (
                <span>{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div
        class="blog-prose prose max-w-none prose-headings:scroll-mt-8 prose-a:no-underline hover:prose-a:underline prose-pre:overflow-x-auto"
      >
        <Content />
      </div>
    </article>
    {toc.length > 0 && <BlogToc headings={toc} />}
  </div>
</Layout>
