---
import Layout from '@/layouts/Layout.astro'
import PublicationsList from '@/components/ui/PublicationsList.astro'
import { publications } from '@/data/cv'
import { sortPublicationsNewToOld } from '@/lib/publications'

const papers = sortPublicationsNewToOld(publications)
---

<Layout
  title="Publications | Yicheng Xu"
  description="Journal articles, conference papers, and research software publications by Yicheng Xu."
>
  <section>
    <h1 class="text-3xl font-bold">Publications</h1>
    <div class="mt-8">
      <PublicationsList elements={papers} />
    </div>
  </section>
</Layout>
